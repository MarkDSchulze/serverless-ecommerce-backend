# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default

# Deployment Stage
STAGE=dev

# DynamoDB Tables
# These are auto-generated by serverless.yml based on stage
# Format: {service-name}-{resource}-{stage}
PRODUCTS_TABLE=serverless-ecommerce-backend-products-dev
ORDERS_TABLE=serverless-ecommerce-backend-orders-dev
CART_TABLE=serverless-ecommerce-backend-cart-dev

# S3 Bucket
# Auto-generated by serverless.yml
IMAGES_BUCKET=serverless-ecommerce-backend-images-dev

# EventBridge
EVENT_BUS_NAME=serverless-ecommerce-backend-events-dev

# Logging
# Options: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# API Configuration
# Set after deployment
API_URL=https://YOUR-API-ID.execute-api.us-east-1.amazonaws.com/dev

# CloudFront Distribution
# Set after deployment
CLOUDFRONT_DOMAIN=YOUR-CLOUDFRONT-ID.cloudfront.net

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copy this file to .env
#    cp .env.example .env
#
# 2. Update values after deployment
#    - API_URL: Get from 'serverless deploy' output
#    - CLOUDFRONT_DOMAIN: Get from AWS Console
#
# 3. NEVER commit .env to git!
#    (Already in .gitignore)
#
# ============================================
# PRODUCTION NOTES
# ============================================
# For production, use:
# - STAGE=prod
# - Separate AWS account (recommended)
# - AWS Secrets Manager for sensitive data
# - Environment-specific configurations
